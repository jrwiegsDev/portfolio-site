# Copy to .env and fill in real values. Never commit .env.

# Gmail account that sends and receives contact form notifications.
# EMAIL_PASS must be a Gmail app password: https://myaccount.google.com/apppasswords
EMAIL_USER=you@gmail.com
EMAIL_PASS=

# Frontend origin allowed by CORS (no trailing slash). Production: https://jrwportfolio.com
FRONTEND_URL=http://localhost:5173
